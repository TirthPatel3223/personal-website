# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent files (regenerated by next dev)
/AGENTS.md
/CLAUDE.md

# Render input for the Maltese stage images (regenerate with scripts/3d/export-maltese-stages.gen.mjs)
/scripts/3d/render/

# Vitest cache inside the 3D scripts folder
/scripts/3d/node_modules/
